rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to verify admin privilege via custom claim or admin email
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email in ['admin@andhrasofttech.com']
      );
    }

    // Vendors: Read allowed for authenticated users; writes strictly restricted to verified admin
    // Note: Production operations primarily route through Flask REST API with Firebase Admin SDK
    match /vendors/{vendorId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Collections & extraction jobs: Read allowed for authenticated users; writes restricted to admin
    match /collections/{collectionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Sources: Read allowed for authenticated users; writes restricted to admin
    match /sources/{sourceId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Custom Columns: Read allowed for authenticated users; writes restricted to admin
    match /customColumns/{columnId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Table Presets: Read & write allowed for authenticated users
    match /tablePresets/{presetId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Categories: Read and write for authenticated users (custom category persistence)
    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Import/Export Jobs: Admin only
    match /importJobs/{jobId} {
      allow read, write: if isAdmin();
    }
    match /exportJobs/{jobId} {
      allow read, write: if isAdmin();
    }

    // Audit logs: Read allowed for admin; writes handled by server-side Firebase Admin SDK
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Server-side admin SDK only
    }

    // User Profiles:
    // Any authenticated user can read their own profile; admins can read all profiles.
    // Users can create their own profile document with role 'user' (never admin) and status 'pending'.
    // Only verified admins can promote users or modify roles.
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId && (
        request.resource.data.role == 'user' || isAdmin()
      );
      allow update: if isAdmin() || (
        isAuthenticated() && request.auth.uid == userId &&
        request.resource.data.role == resource.data.role
      );
      allow delete: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
