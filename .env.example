# ==============================================================================
# ANDHRA SOFT TECH — LEAD FINDER
# Environment Configuration Template
# ==============================================================================

# --- Frontend Environment Variables (Vite) ---
VITE_API_URL=http://localhost:5000/api/v1
VITE_APP_NAME="ANDHRA SOFT TECH — Lead Finder"
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# --- Backend Environment Variables (Flask / Python) ---
FLASK_APP=app
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
SECRET_KEY=change_this_to_a_secure_random_key_in_production

# PostgreSQL Database (Supabase or Local)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/andhra_soft_tech_leads

# Firebase Admin SDK Credentials
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Worker & Extraction Configuration
WORKER_CONCURRENCY=4
BATCH_SIZE=500
MAX_RETRIES=3
RATE_LIMIT_PER_MINUTE=60
