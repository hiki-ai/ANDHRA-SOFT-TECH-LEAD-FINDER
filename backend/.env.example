# ==============================================================================
# ANDHRA SOFT TECH — LEAD FINDER
# Backend Environment Configuration Template (Flask / Render)
# ==============================================================================

FLASK_APP=run.py
FLASK_ENV=production
DEBUG=False
PORT=5000
HOST=0.0.0.0
SECRET_KEY=generate_a_secure_random_key_for_production
ADMIN_EMAILS=admin@andhrasofttech.com

# Firebase Cloud Firestore & Admin SDK Credentials
FIREBASE_PROJECT_ID=andhra-soft-tech-lead-finder
FIREBASE_STORAGE_BUCKET=andhra-soft-tech-lead-finder.firebasestorage.app

# Set ONE of the following for Firebase Admin authentication on Render:
# 1. Full raw JSON content:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# 2. Or individual service account credentials:
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# 3. Or file path:
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/serviceAccountKey.json

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=https://andhra-soft-tech-lead-finder.vercel.app,http://localhost:5173,http://localhost:3000

# Data Collector Credentials
GOOGLE_MAPS_API_KEY=
JUSTDIAL_API_KEY=
MAGICPIN_API_KEY=

# Optional dedicated worker service URL (if worker is deployed as a separate service)
# WORKER_URL=https://ast-lead-finder-worker.onrender.com
